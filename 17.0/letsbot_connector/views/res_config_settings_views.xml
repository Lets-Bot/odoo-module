<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.letsbot</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="LetsBot WhatsApp" string="LetsBot WhatsApp" name="letsbot_connector"
                     logo="/letsbot_connector/static/description/icon.png" groups="base.group_system">
                    <block title="LetsBot WhatsApp" name="letsbot_connection_block">
                        <setting id="letsbot_connection" string="Connection"
                                 help="Pair this database with your LetsBot workspace. No API key to copy: Odoo hands a dedicated key to LetsBot securely.">
                            <div class="mt8">
                                <field name="letsbot_status" readonly="1" widget="badge"
                                       decoration-success="letsbot_status == 'connected'"
                                       decoration-warning="letsbot_status == 'pending'"
                                       decoration-danger="letsbot_status == 'revoked'"/>
                            </div>
                            <div class="mt8" invisible="not letsbot_account_label">
                                <span class="o_form_label">Workspace: </span>
                                <field name="letsbot_account_label" readonly="1" class="oe_inline"/>
                            </div>
                            <div class="mt8" invisible="not letsbot_last_ping">
                                <span class="o_form_label">Last contact: </span>
                                <field name="letsbot_last_ping" readonly="1" class="oe_inline"/>
                            </div>
                            <div class="mt8 text-danger" invisible="not letsbot_last_error">
                                <field name="letsbot_last_error" readonly="1"/>
                            </div>
                            <div class="mt16">
                                <button name="action_letsbot_connect" type="object" class="btn-primary"
                                        string="Connect to LetsBot" icon="fa-whatsapp"
                                        invisible="letsbot_status == 'connected'"/>
                                <button name="action_letsbot_connect" type="object" class="btn-secondary"
                                        string="Reconnect" invisible="letsbot_status != 'connected'"/>
                                <button name="action_letsbot_test" type="object" class="btn-link"
                                        string="Send test event" invisible="letsbot_status != 'connected'"/>
                                <button name="action_letsbot_disconnect" type="object" class="btn-link text-danger"
                                        string="Disconnect" invisible="letsbot_status not in ('connected', 'pending', 'revoked')"
                                        confirm="Disconnect LetsBot? The LetsBot API key will be revoked and webhooks stop immediately."/>
                            </div>
                        </setting>
                        <setting id="letsbot_events" string="Real-time updates"
                                 help="LetsBot is notified (record id + status only) when these documents change, then re-reads them through the API.">
                            <div class="mt8">
                                <div><field name="letsbot_watch_sale" class="oe_inline"/> <label for="letsbot_watch_sale"/></div>
                                <div><field name="letsbot_watch_invoice" class="oe_inline"/> <label for="letsbot_watch_invoice"/></div>
                                <div><field name="letsbot_watch_picking" class="oe_inline"/> <label for="letsbot_watch_picking"/></div>
                                <div><field name="letsbot_watch_lead" class="oe_inline"/> <label for="letsbot_watch_lead"/></div>
                                <div><field name="letsbot_watch_product" class="oe_inline"/> <label for="letsbot_watch_product"/></div>
                            </div>
                            <div class="mt8">
                                <button name="action_letsbot_open_queue" type="object" class="btn-link" icon="oi-arrow-right">
                                    <field name="letsbot_queue_pending" readonly="1" class="oe_inline"/>
                                    <span> pending webhook events</span>
                                </button>
                            </div>
                        </setting>
                        <setting id="letsbot_advanced" string="Advanced"
                                 help="Defaults work for most companies.">
                            <div class="row mt8">
                                <label for="letsbot_user_id" class="col-lg-4 o_light_label"/>
                                <field name="letsbot_user_id" class="col-lg-8" options="{'no_create': True}"/>
                            </div>
                            <div class="row mt8">
                                <label for="letsbot_key_days" class="col-lg-4 o_light_label"/>
                                <field name="letsbot_key_days" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="letsbot_connect_url" class="col-lg-4 o_light_label"/>
                                <field name="letsbot_connect_url" class="col-lg-8"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
