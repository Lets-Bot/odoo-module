<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="letsbot_webhook_event_view_list" model="ir.ui.view">
        <field name="name">letsbot.webhook.event.tree</field>
        <field name="model">letsbot.webhook.event</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-muted="state == 'sent'" decoration-danger="state == 'dead'">
                <field name="create_date"/>
                <field name="event"/>
                <field name="model" optional="hide"/>
                <field name="res_id"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-danger="state == 'dead'" decoration-info="state == 'pending'"/>
                <field name="attempts"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="last_status_code" optional="show"/>
                <field name="last_error" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="letsbot_webhook_event_view_form" model="ir.ui.view">
        <field name="name">letsbot.webhook.event.form</field>
        <field name="model">letsbot.webhook.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_retry" type="object" string="Retry" invisible="state == 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event"/>
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="record_write_date"/>
                            <field name="values_json"/>
                        </group>
                        <group>
                            <field name="uid_token"/>
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="sent_at"/>
                            <field name="last_status_code"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="letsbot_webhook_event_view_search" model="ir.ui.view">
        <field name="name">letsbot.webhook.event.search</field>
        <field name="model">letsbot.webhook.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event"/>
                <field name="model"/>
                <field name="res_id"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_dead" string="Failed" domain="[('state', '=', 'dead')]"/>
                <filter name="filter_sent" string="Sent" domain="[('state', '=', 'sent')]"/>
            </search>
        </field>
    </record>

    <record id="action_letsbot_webhook_event" model="ir.actions.act_window">
        <field name="name">LetsBot Webhook Events</field>
        <field name="res_model">letsbot.webhook.event</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <menuitem id="menu_letsbot_webhook_event"
              name="LetsBot Webhook Events"
              parent="base.menu_custom"
              action="action_letsbot_webhook_event"
              groups="base.group_system"
              sequence="90"/>
</odoo>
