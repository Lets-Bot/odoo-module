<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_letsbot_webhook_dispatch" model="ir.cron">
        <field name="name">LetsBot: deliver webhook events</field>
        <field name="model_id" ref="model_letsbot_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_dispatch(commit=True)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
